---
import { site } from '../content/site';
const { compact = false } = Astro.props;
---

<header class:list={['brand-header', { compact }]}>
  <a class="brand-mark" href="/" aria-label="GTP Special Occasion Websites home">
    <span class="brand-mark-image" aria-hidden="true">
      <img src="/brand/griffin-mark-160.webp" alt="" width="44" height="44" />
    </span>
    <span class="brand-mark-copy">
      <strong>Griffin Technology Partners</strong>
      <small>Special Occasion Websites</small>
    </span>
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="brand-nav"
    >Menu</button
  >
  <nav id="brand-nav" aria-label="Primary navigation">
    <a href="/#occasions">Explore occasions</a>
    <a href="/#process">How it works</a>
    <a href="/about-the-demos">About the demos</a>
    <a class="button button-small button-crimson" href={site.purchaseOptions[0].url}
      >Start yours · {site.price}</a
    >
  </nav>
</header>
