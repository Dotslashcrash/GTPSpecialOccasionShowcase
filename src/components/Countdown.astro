---
const { label, eventDate } = Astro.props as { label: string; eventDate: string };
---

<div class="countdown" aria-label={label} data-countdown={eventDate}>
  <span><strong data-countdown-days>—</strong><small>days</small></span>
  <span><strong data-countdown-hours>—</strong><small>hours</small></span>
  <span><strong data-countdown-minutes>—</strong><small>minutes</small></span>
</div>
