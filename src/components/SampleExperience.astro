---
import { occasions, type Occasion } from '../content/occasions';
import { site } from '../content/site';
import Countdown from './Countdown.astro';
import PhotoCredit from './PhotoCredit.astro';
import ShareButton from './ShareButton.astro';

const { occasion } = Astro.props as { occasion: Occasion };
const hasCountdown = Boolean(occasion.eventDate);
const responseCopy = {
  rsvp: {
    title: 'RSVP demonstration',
    label: 'Sample response',
    options: ['Joyfully attending', 'Unable to attend, but sending warm wishes'],
  },
  tribute: {
    title: 'Contribute to the family archive',
    label: 'Sample contribution',
    options: [
      'Share a family-approved memory',
      'Contribute a photograph',
      'Leave a tribute for moderation',
    ],
  },
  condolence: {
    title: 'Attendance and condolences',
    label: 'Sample response',
    options: [
      'Planning to attend',
      'Unable to attend, but sending condolences',
      'Leave a condolence for family review',
    ],
  },
  reveal: {
    title: 'Send a little appreciation',
    label: 'Sample reaction',
    options: ['This made me smile', 'Leave a personal message', 'Save this letter for later'],
  },
  announcement: {
    title: 'Celebrate the news',
    label: 'Sample reaction',
    options: ['Celebrate the news', 'Leave a message', 'Request future updates'],
  },
}[occasion.interaction];
const currentIndex = occasions.findIndex((item) => item.slug === occasion.slug);
const nextOccasion = occasions[(currentIndex + 1) % occasions.length] ?? occasions[0]!;
---

<div
  class={`sample sample-${occasion.theme} layout-${occasion.layout}`}
  data-occasion={occasion.slug}
>
  <a class="sample-back" href="/">
    <span
      ><img src="/brand/griffin-mark-160.webp" alt="" width="24" height="24" />GTP portfolio</span
    >
    <span>All occasions <span aria-hidden="true">↗</span></span>
  </a>
  <header class="sample-nav">
    <a class="sample-monogram" href="#sample-top" aria-label={`${occasion.sampleName} home`}>
      <span aria-hidden="true">{occasion.sampleName.charAt(0)}</span>
      <strong>{occasion.sampleName}</strong>
    </a>
    <nav aria-label={`${occasion.category} sample navigation`}>
      {
        occasion.sections.map((section, index) => (
          <a href={`#story-${index + 1}`}>{section.eyebrow}</a>
        ))
      }
      <a href="#details">Details</a>
    </nav>
  </header>

  <main id="main-content">
    <section class="sample-hero" id="sample-top" aria-labelledby="sample-title">
      <div class="sample-hero-copy">
        <p class="sample-kicker">
          A fictional {occasion.category.toLowerCase()} website experience
        </p>
        <h1 id="sample-title">{occasion.title}</h1>
        <p class="sample-intro">{occasion.introduction}</p>
        <div class="sample-actions">
          <a class="sample-primary" href="#details">See the details</a>
          <a href={`/samples/${occasion.slug}/admin-preview`}>Enter Interactive Admin Preview</a>
        </div>
      </div>
      <figure class="sample-hero-image">
        <img src={occasion.heroImage} alt={occasion.heroAlt} width="1100" height="820" />
        <figcaption>
          <span>{occasion.dateValue}</span>
          <PhotoCredit credit={occasion.heroCredit} compact />
        </figcaption>
      </figure>
      {
        occasion.layout === 'cinematic' && (
          <div class="hero-number" aria-hidden="true">
            40
          </div>
        )
      }
      {
        occasion.layout === 'editorial' && (
          <p class="hero-side-note">
            An autumn promise
            <br />
            beside the water
          </p>
        )
      }
      {
        occasion.layout === 'reveal' && (
          <button class="reveal-button" type="button" aria-expanded="false" data-reveal>
            Open the news
          </button>
        )
      }
    </section>

    {
      hasCountdown && (
        <section class="sample-countdown">
          <>
            <p>{occasion.dateLabel}</p>
            <strong>{occasion.dateValue}</strong>
            <Countdown
              label={`Sample countdown for ${occasion.sampleName}`}
              eventDate={occasion.eventDate!}
            />
          </>
        </section>
      )
    }

    <section class="sample-statement" id="story-1">
      <div>
        <p>{occasion.sections[0]?.eyebrow}</p>
        <h2>{occasion.sections[0]?.title}</h2>
      </div>
      <div>
        <p>{occasion.sections[0]?.body}</p>
        {
          occasion.sections[0]?.items && (
            <ul>
              {occasion.sections[0].items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <section class="sample-photo-story" id="story-2">
      <figure>
        <img
          src={occasion.detailImage}
          alt={occasion.detailAlt}
          width="900"
          height="760"
          loading="lazy"
        />
        <figcaption><PhotoCredit credit={occasion.detailCredit} compact /></figcaption>
      </figure>
      <div>
        <p>{occasion.sections[1]?.eyebrow}</p>
        <h2>{occasion.sections[1]?.title}</h2>
        <p>{occasion.sections[1]?.body}</p>
        {
          occasion.sections[1]?.items && (
            <ol>
              {occasion.sections[1].items.map((item) => (
                <li>{item}</li>
              ))}
            </ol>
          )
        }
      </div>
    </section>

    <section class="sample-timeline" aria-labelledby="timeline-title">
      <p>
        {
          occasion.slug === 'funerals'
            ? 'Service sequence'
            : occasion.slug === 'reunions'
              ? 'Weekend guide'
              : 'A few chapters'
        }
      </p>
      <h2 id="timeline-title">
        {
          occasion.slug === 'birthdays'
            ? 'Life, in bright moments'
            : occasion.slug === 'memorials'
              ? 'A life, carefully kept'
              : occasion.slug === 'retirements'
                ? 'Work that moved things forward'
                : 'The story so far'
        }
      </h2>
      <div class="timeline-track">
        {
          occasion.timeline.map((item) => (
            <article>
              <>
                <strong>{item.year}</strong>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section class="sample-third" id="story-3">
      <p>{occasion.sections[2]?.eyebrow}</p>
      <h2>{occasion.sections[2]?.title}</h2>
      <p>{occasion.sections[2]?.body}</p>
      {
        occasion.sections[2]?.items && (
          <ul>
            {occasion.sections[2].items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
    </section>

    <section
      class={`sample-gallery gallery-${occasion.galleryStyle}`}
      aria-labelledby="gallery-title"
      data-public-gallery
    >
      <div class="gallery-heading">
        <p>{occasion.category} gallery</p>
        <h2 id="gallery-title">Photographs that give the story texture.</h2>
        <p>
          Select any image for a closer look. Every photograph is licensed stock imagery used only
          for this fictional portfolio sample.
        </p>
      </div>
      <div class="gallery-grid">
        {
          occasion.gallery.map((image, index) => (
            <figure>
              <button
                type="button"
                data-gallery-open={index}
                aria-label={`Open image ${index + 1} of ${occasion.gallery.length}: ${image.caption}`}
              >
                <img
                  src={image.src}
                  alt={image.alt}
                  width={image.width}
                  height={image.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </button>
              <figcaption>
                <span>{image.caption}</span>
                {index < 2 && (
                  <PhotoCredit
                    credit={index === 0 ? occasion.heroCredit : occasion.detailCredit}
                    compact
                  />
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <dialog class="gallery-lightbox" data-gallery-dialog aria-labelledby="lightbox-caption">
        <div class="lightbox-shell">
          <button
            type="button"
            class="lightbox-close"
            data-gallery-close
            aria-label="Close image viewer">×</button
          >
          <button type="button" class="lightbox-prev" data-gallery-prev aria-label="Previous image"
            >←</button
          >
          <figure data-gallery-swipe>
            <img data-gallery-image src="" alt="" width="1400" height="1050" />
            <figcaption id="lightbox-caption" data-gallery-caption></figcaption>
          </figure>
          <button type="button" class="lightbox-next" data-gallery-next aria-label="Next image"
            >→</button
          >
          <p data-gallery-position aria-live="polite"></p>
        </div>
      </dialog>
    </section>

    <section class="sample-details" id="details" aria-labelledby="details-title">
      <div class="details-heading">
        <p>{occasion.dateLabel}</p><h2 id="details-title">{occasion.dateValue}</h2>
      </div>
      <dl>
        {
          occasion.details.map((detail) => (
            <div>
              <>
                <dt>{detail.label}</dt>
                <dd>{detail.value}</dd>
              </>
            </div>
          ))
        }
      </dl>
      <form class="rsvp-demo" data-rsvp-demo>
        <h3>{responseCopy.title}</h3>
        <p>No information leaves this browser.</p>
        <label for={`rsvp-${occasion.slug}`}>{responseCopy.label}</label>
        <select id={`rsvp-${occasion.slug}`}>
          <option>Choose a response</option>
          {responseCopy.options.map((option) => <option>{option}</option>)}
        </select>
        <button type="submit">Save sample response</button>
        <p class="rsvp-status" aria-live="polite"></p>
      </form>
    </section>

    <section class="sample-messages" aria-labelledby="messages-title">
      <div><p>Words from the circle</p><h2 id="messages-title">Messages worth keeping.</h2></div>
      <div>
        {
          occasion.messages
            .filter((message) => message.status === 'Approved')
            .map((message) => (
              <blockquote>
                <>
                  <p>“{message.message}”</p>
                  <footer>
                    {message.name} · {message.relationship}
                  </footer>
                </>
              </blockquote>
            ))
        }
      </div>
    </section>

    <section class="sample-resources" aria-labelledby="resources-title">
      <div><p>Helpful links</p><h2 id="resources-title">Everything in one place.</h2></div>
      <ul>
        {
          occasion.resources.map((resource) => (
            <li>
              <>
                <span>{resource.kind}</span>
                <strong>{resource.label}</strong>
                <small>{resource.value}</small>
                <button
                  type="button"
                  data-demo-resource
                  data-resource-kind={resource.kind}
                  data-resource-label={resource.label}
                >
                  Preview {resource.kind.toLowerCase()} information
                </button>
              </>
            </li>
          ))
        }
      </ul>
      <dialog class="resource-dialog" data-resource-dialog aria-labelledby="resource-dialog-title">
        <div>
          <p>Fictional demonstration</p>
          <h3 id="resource-dialog-title" data-resource-dialog-title>Preview customer link</h3>
          <p data-resource-dialog-copy>
            This control demonstrates where a customer-approved destination would open on a finished
            site. It does not contact an outside organization.
          </p>
          <button type="button" data-resource-dialog-close>Close preview</button>
        </div>
      </dialog>
    </section>

    <section class="sample-share">
      <h2>Keep the people you love close to the moment.</h2><div>
        <ShareButton /><a href={`/samples/${occasion.slug}/admin-preview`}
          >Preview how this site is managed</a
        >
      </div>
    </section>
  </main>
  <footer class="sample-footer">
    <div class="sample-footer-brand">
      <img src="/brand/griffin-mark-160.webp" alt="" width="38" height="38" />
      <p>This is a fictional portfolio example created by Griffin Technology Partners.</p>
    </div>
    <nav aria-label="Continue exploring">
      <a href={`/samples/${nextOccasion.slug}`}>Explore another occasion</a>
      <a href={`/samples/${occasion.slug}/admin-preview`}>Preview the client portal</a>
      <a href="/photo-credits">Demo photo credits</a>
      <a href={`${site.offerUrl}?occasion=${occasion.slug}`}>Start your site with GTP</a>
    </nav>
  </footer>
</div>
