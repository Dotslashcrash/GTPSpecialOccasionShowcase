---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandHeader from '../components/BrandHeader.astro';
import BrandFooter from '../components/BrandFooter.astro';
---

<BaseLayout
  title="Private Website Access Demo | GTP Special Occasion Websites"
  description="Try the private access cover available for Griffin Technology Partners special-occasion websites using the demonstration key Surprise."
  canonicalPath="/private-access-demo"
>
  <BrandHeader compact />
  <main id="main-content" class="private-demo-page">
    <section class="private-gate" data-private-gate aria-labelledby="private-gate-title">
      <div class="private-gate-card">
        <span class="private-lock" aria-hidden="true">
          <svg viewBox="0 0 48 48" role="img">
            <path d="M15 21v-6a9 9 0 0 1 18 0v6" fill="none" stroke="currentColor" stroke-width="3"
            ></path>
            <rect
              x="10"
              y="21"
              width="28"
              height="21"
              rx="3"
              fill="none"
              stroke="currentColor"
              stroke-width="3"></rect>
            <circle cx="24" cy="31" r="2.5" fill="currentColor"></circle>
          </svg>
        </span>
        <p class="eyebrow">Private access demonstration</p>
        <h1 id="private-gate-title">A surprise is waiting.</h1>
        <p>
          This cover keeps the occasion private until a visitor enters the access key shared by the
          customer.
        </p>
        <form class="private-key-form" data-private-key-form novalidate>
          <label for="private-demo-key">Secure access key</label>
          <div>
            <input
              id="private-demo-key"
              name="access-key"
              type="password"
              autocomplete="off"
              aria-describedby="private-key-help private-key-status"
              required
            />
            <button class="button button-crimson" type="submit">Open the surprise</button>
          </div>
          <p id="private-key-help">Demo access key: <strong>Surprise</strong></p>
          <p
            id="private-key-status"
            class="private-key-status"
            data-private-key-status
            aria-live="polite"
          >
          </p>
        </form>
        <small>
          This public page demonstrates the visitor experience. Real customer access is protected
          and configured separately for the finished project.
        </small>
      </div>
    </section>

    <section
      class="private-reveal"
      data-private-reveal
      aria-labelledby="private-reveal-title"
      hidden
    >
      <img
        src="/media/home/birthdays-1200.webp"
        srcset="/media/home/birthdays-480.webp 480w, /media/home/birthdays-800.webp 800w, /media/home/birthdays-1200.webp 1200w"
        sizes="100vw"
        alt="Friends celebrating a fictional surprise birthday"
        width="1600"
        height="1000"
      />
      <div class="private-reveal-overlay"></div>
      <div class="private-reveal-copy">
        <p class="eyebrow">You found the surprise</p>
        <h1 id="private-reveal-title" tabindex="-1">Here’s to your brightest year yet.</h1>
        <p>
          A fictional private birthday experience, revealed only after entering the shared demo key.
        </p>
        <button class="button button-ghost" type="button" data-private-lock
          >Lock the demo again</button
        >
      </div>
    </section>
  </main>
  <BrandFooter />
</BaseLayout>
