---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandHeader from '../components/BrandHeader.astro';
import BrandFooter from '../components/BrandFooter.astro';
import { occasions } from '../content/occasions';
import { site } from '../content/site';
---

<BaseLayout
  title="Special Occasion Website Portfolio | Griffin Technology Partners"
  description="Explore twelve custom website and client-portal experiences for celebrations, announcements, gatherings, and remembrance."
>
  <BrandHeader />
  <main id="main-content">
    <section class="portfolio-hero">
      <div class="hero-copy">
        <p class="eyebrow">Custom occasion websites by GTP</p>
        <h1>{site.hero}</h1>
        <p class="lede">
          A celebration, announcement, gathering, or remembrance deserves more than a generic event
          page. We design a distinct public experience and a practical place for you to manage it.
        </p>
        <div class="hero-actions">
          <a class="button" href="#occasions">Explore 12 experiences</a>
          <a class="text-link" href={site.offerUrl}
            >See the {site.price} starting package <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <div class="hero-stage" aria-label="A collage of fictional special occasion samples">
        {
          occasions.slice(0, 4).map((occasion, index) => (
            <a class={`stage-card stage-${index + 1}`} href={`/samples/${occasion.slug}`}>
              <img
                src={occasion.heroImage}
                alt=""
                width="520"
                height="650"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'low'}
              />
              <span>{occasion.category}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="occasion-browser" id="occasions" aria-labelledby="occasion-heading">
      <div class="section-heading">
        <p class="eyebrow">Twelve different stories</p>
        <h2 id="occasion-heading">Find the shape of your moment.</h2>
        <p>
          Each sample has its own structure, visual language, content, and tailored administration
          preview.
        </p>
      </div>
      <div class="filters" role="group" aria-label="Filter occasions">
        <button class="filter active" type="button" data-filter="all" aria-pressed="true"
          >All</button
        >
        <button class="filter" type="button" data-filter="celebrate" aria-pressed="false"
          >Celebrate</button
        >
        <button class="filter" type="button" data-filter="gather" aria-pressed="false"
          >Gather</button
        >
        <button class="filter" type="button" data-filter="remember" aria-pressed="false"
          >Remember</button
        >
        <button class="filter" type="button" data-filter="announce" aria-pressed="false"
          >Announce</button
        >
      </div>
      <div class="occasion-grid">
        {
          occasions.map((occasion, index) => {
            const group = ['memorials', 'funerals'].includes(occasion.slug)
              ? 'remember'
              : ['reunions', 'holidays', 'weddings'].includes(occasion.slug)
                ? 'gather'
                : ['announcements', 'baby-showers'].includes(occasion.slug)
                  ? 'announce'
                  : 'celebrate';
            return (
              <article class={`occasion-card card-${(index % 4) + 1}`} data-group={group}>
                <a
                  class="card-image"
                  href={`/samples/${occasion.slug}`}
                  aria-label={`View ${occasion.category} guest experience`}
                >
                  <img
                    src={occasion.heroImage}
                    alt={occasion.heroAlt}
                    width="760"
                    height="620"
                    loading="lazy"
                  />
                  <span>{String(index + 1).padStart(2, '0')}</span>
                </a>
                <div class="card-copy">
                  <p>
                    {occasion.category} · {occasion.mood}
                  </p>
                  <h3>{occasion.sampleName}</h3>
                  <p>{occasion.shortDescription}</p>
                  <div class="card-actions">
                    <a href={`/samples/${occasion.slug}`}>View Guest Experience</a>
                    <a href={`/samples/${occasion.slug}/admin-preview`}>Preview Client Portal</a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="two-sides" aria-labelledby="two-sides-title">
      <div class="section-heading light">
        <p class="eyebrow">One website, two clear experiences</p>
        <h2 id="two-sides-title">Beautiful for guests. Manageable for you.</h2>
      </div>
      <div class="comparison">
        <article>
          <span aria-hidden="true">01</span><h3>What guests see</h3><p>
            A thoughtful, responsive website with the story, details, photographs, resources, and
            sharing tools appropriate to your occasion.
          </p>
        </article>
        <article>
          <span aria-hidden="true">02</span><h3>What you manage</h3><p>
            A protected administration area configured for approved users, so content and media can
            stay current without rebuilding the site.
          </p>
        </article>
      </div>
      <p class="comparison-note">
        The public portal previews in this portfolio are local demonstrations. Real customer
        administration is protected and configured for the customer’s approved users.
      </p>
    </section>

    <section class="offer-band">
      <div>
        <p class="eyebrow">A clear starting point</p>
        <h2>{site.price} <small>{site.billing}</small></h2>
        <ul>{site.inclusions.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="offer-action">
        <p>
          Every site is customized around the people, purpose, and practical needs of the moment.
        </p>
        <a class="button" href={site.offerUrl}>Start your site</a>
        <p class="checkout-note">
          The complete offer and secure one-time checkout live on the Griffin Technology Partners
          website.
        </p>
        <a class="text-link" href={site.offerUrl}>Review the complete offer</a><a
          class="text-link"
          href={`mailto:${site.salesEmail}`}>Or email {site.salesEmail}</a
        >
      </div>
    </section>
  </main>
  <BrandFooter />
</BaseLayout>
